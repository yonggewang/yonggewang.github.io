sub open_TCP {
    ($dest, $port) = @_;
    $proto = getprotobyname('tcp');
    socket('F', PF_INET, SOCK_STREAM, $proto);
    $sin = sockaddr_in($port,inet_aton($dest));
    connect('F',$sin) || return undef;
    $old_fh = select(F);
    $| = 1;
    select($old_fh);
    1;
}
